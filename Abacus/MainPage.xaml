<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Abacus.MainPage"
             BackgroundColor="#617891">

    <Grid RowDefinitions="*, Auto, Auto, Auto, Auto, Auto"
          ColumnDefinitions="*, *, *, *"
          Padding="20"
          RowSpacing="10"
          ColumnSpacing="10">


        <!-- Экран калькулятора -->
        <Border Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="4"
                BackgroundColor="#D5B893"
                Stroke="#25344F"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 12"
                Margin="0, 0, 0, 10">

            <Label x:Name="displayText"
                   Text="0"
                   FontSize="42"
                   TextColor="#25344F"
                   HorizontalOptions="End"
                   VerticalTextAlignment="Center"
                   Grid.Row="0"
                   Grid.ColumnSpan="4"
                   Padding="20, 0" />
        </Border>

        <!-- Кнопка сброса -->
        <Button x:Name="buttonClear" 
                Text="Сброс"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Clicked="buttonClear_Clicked"
                BackgroundColor="#632024"
                TextColor="#D5B893"
                FontSize="42" />

        <!-- Кнопки с цифрами 7, 8, 9 -->
        <Button x:Name="buttonSeven"
                Text="7"
                Grid.Row="2"
                Grid.Column="0"
                Clicked="buttonDigits_Clicked"
                BackgroundColor="#25344F"
                TextColor="#617891"
                FontSize="42" />

        <Button x:Name="buttonEight"
                Text="8"
                Grid.Row="2"
                Grid.Column="1"
                Clicked="buttonDigits_Clicked"
                BackgroundColor="#25344F"
                TextColor="#617891"
                FontSize="42" />

        <Button x:Name="buttonNine"
                Text="9"
                Grid.Row="2"
                Grid.Column="2"
                Clicked="buttonDigits_Clicked"
                BackgroundColor="#25344F"
                TextColor="#617891"
                FontSize="42" />

        <!-- Кнопки с цифрами 4, 5, 6 -->
        <Button x:Name="buttonFour" 
                Text="4"
                Grid.Row="3"
                Grid.Column="0"
                Clicked="buttonDigits_Clicked"
                BackgroundColor="#25344F"
                TextColor="#617891"
                FontSize="42" />

        <Button x:Name="buttonFive" 
                Text="5"
                Grid.Row="3"
                Grid.Column="1"
                Clicked="buttonDigits_Clicked"
                BackgroundColor="#25344F"
                TextColor="#617891"
                FontSize="42" />

        <Button x:Name="buttonSix" 
                Text="6"
                Grid.Row="3"
                Grid.Column="2"
                Clicked="buttonDigits_Clicked"
                BackgroundColor="#25344F"
                TextColor="#617891"
                FontSize="42" />

        <!-- Кнопки с цифрами 1, 2, 3 -->
        <Button x:Name="buttonOne" 
                Text="1"
                Grid.Row="4"
                Grid.Column="0"
                Clicked="buttonDigits_Clicked"
                BackgroundColor="#25344F"
                TextColor="#617891"
                FontSize="42" />

        <Button x:Name="buttonTwo" 
                Text="2"
                Grid.Row="4"
                Grid.Column="1"
                Clicked="buttonDigits_Clicked"
                BackgroundColor="#25344F"
                TextColor="#617891"
                FontSize="42" />

        <Button x:Name="buttonThree" 
                Text="3"
                Grid.Row="4"
                Grid.Column="2"
                Clicked="buttonDigits_Clicked"
                BackgroundColor="#25344F"
                TextColor="#617891"
                FontSize="42" />

        <!-- Кнопки смены знака, цифры 0 и десятичного разделителя -->
        <Button x:Name="buttonToggleSign" 
                Text="&#177;"
                Grid.Row="5"
                Grid.Column="0"
                Clicked="buttonToggleSign_Clicked"
                BackgroundColor="#25344F"
                TextColor="#617891"
                FontSize="42" />

        <Button x:Name="buttonZero" 
                Text="0"
                Grid.Row="5"
                Grid.Column="1"
                Clicked="buttonDigits_Clicked"
                BackgroundColor="#25344F"
                TextColor="#617891"
                FontSize="42" />

        <Button x:Name="buttonDecimal" 
                Text=","
                Grid.Row="5"
                Grid.Column="2"
                Clicked="buttonDecimal_Clicked"
                BackgroundColor="#25344F"
                TextColor="#617891"
                FontSize="42" />

        <!-- Кнопки арифметических операций -->
        <Button x:Name="buttonDivideOperator" 
                Text="&#247;"
                Grid.Row="1"
                Grid.Column="3"
                Clicked="buttonOperators_Clicked"
                BackgroundColor="#D5B893"
                TextColor="#6F4D38"
                FontSize="42" />

        <Button x:Name="buttonMultiplyOperator" 
                Text="&#215;"
                Grid.Row="2"
                Grid.Column="3"
                Clicked="buttonOperators_Clicked"
                BackgroundColor="#D5B893"
                TextColor="#6F4D38"
                FontSize="42" />

        <Button x:Name="buttonMinusOperator" 
                Text="&#45;"
                Grid.Row="3"
                Grid.Column="3"
                Clicked="buttonOperators_Clicked"
                BackgroundColor="#D5B893"
                TextColor="#6F4D38"
                FontSize="42" />

        <Button x:Name="buttonPlusOperator" 
                Text="&#43;"
                Grid.Row="4"
                Grid.Column="3"
                Clicked="buttonOperators_Clicked"
                BackgroundColor="#D5B893"
                TextColor="#6F4D38"
                FontSize="42" />

        <!-- Кнопка результата -->
        <Button x:Name="buttonEqual" 
                Text="&#61;"
                Grid.Row="5"
                Grid.Column="3"
                Clicked="buttonEqual_Clicked"
                BackgroundColor="#6F4D38"
                TextColor="#D5B893"
                FontSize="42" />
    </Grid>
</ContentPage>
